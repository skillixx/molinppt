# Moling platform configuration. Production values should be injected by the
# deployment platform or secret manager.
MOLING_API_BASE_URL=
INTERNAL_API_TOKEN=
LOCAL_MOLING_MOCK=false

# Local mock values are only used when LOCAL_MOLING_MOCK=true.
LOCAL_MOLING_USER_ID=
LOCAL_MOLING_ENTITLEMENT_ID=
LOCAL_MOLING_INITIAL_CREDITS=

# Test-only credentials. Do not commit real accounts or passwords.
TEST_ACCOUNT=
TEST_PASSWORD=

# Application runtime.
APP_ENV=development
APP_PORT=5177
APP_BASE_URL=
PORT=

# Moling app/product binding. PPT_* names are compatibility aliases.
MOLING_APP_ID=
MOLING_PRODUCT_ID=
MOLING_USER_ENTITLEMENT_MAP=
MOLING_DEFAULT_ENTITLEMENT_ID=
PPT_APP_ID=
PPT_PRODUCT_ID=
PPT_DEFAULT_ENTITLEMENT_ID=

# Session and rate limit settings.
SESSION_TTL_SECONDS=
SESSION_COOKIE_SECURE=
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# Database and local storage.
DATABASE_URL=
STORAGE_DIR=
OFFICIAL_TEMPLATES_DIR=

# Object storage. Configure these for MinIO/S3-compatible storage.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI providers.
LLM_PROVIDER=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=

# Optional preview renderer. Leave empty to use HTML fallback preview.
PPT_PREVIEW_RENDERER_COMMAND=
PPT_PREVIEW_IMAGE_RENDERER_COMMAND=
PPT_PREVIEW_RENDERER_TIMEOUT_MS=

# Optional vision and image providers.
VISION_PROVIDER=none
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
IMAGE_PROVIDER=none
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
